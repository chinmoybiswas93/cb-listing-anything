{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cb-listing-anything/listing-cards-slider",
	"title": "Listing Cards Slider",
	"category": "widgets",
	"icon": "images-alt2",
	"description": "Display listing cards in a horizontal slider with full card layout and query controls.",
	"keywords": [ "listings", "slider", "carousel", "cards" ],
	"textdomain": "cb-listing-anything",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		},
		"buttonPosition": {
			"type": "string",
			"default": "outside"
		},
		"buttonOutsideOffset": {
			"type": "number",
			"default": 0
		},
		"itemsToShow": {
			"type": "number",
			"default": 4
		},
		"itemsToShowDesktop": {
			"type": "number",
			"default": 4
		},
		"itemsToShowTablet": {
			"type": "number",
			"default": 2
		},
		"itemsToShowMobile": {
			"type": "number",
			"default": 1
		},
		"arrowBackgroundColor": {
			"type": "string"
		},
		"arrowIconColor": {
			"type": "string"
		},
		"arrowBorderRadius": {
			"type": "number",
			"default": 50
		},
		"arrowPadding": {
			"type": "number",
			"default": 0
		},
		"useCurrentQuery": {
			"type": "boolean",
			"default": false
		},
		"postsPerPage": {
			"type": "number",
			"default": 8
		},
		"category": {
			"type": "number",
			"default": 0
		},
		"showCategories": {
			"type": "boolean",
			"default": true
		},
		"showOpenStatus": {
			"type": "boolean",
			"default": true
		},
		"showPrice": {
			"type": "boolean",
			"default": true
		},
		"showTags": {
			"type": "boolean",
			"default": true
		},
		"showAddress": {
			"type": "boolean",
			"default": true
		},
		"showCallButton": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"render": "file:./render.php"
}

